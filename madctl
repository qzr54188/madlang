#!/bin/bash
set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
V5="$DIR/madlangv5"
GEN="$DIR/mad5gen.py"

need_bin() { [ -x "$V5" ] || { echo "先跑: madctl compile" >&2; exit 1; }; }

case "${1:-help}" in
  compile)
    g++ -std=c++11 -O2 -pthread -o "$V5" "$DIR/madlangv5.cpp"
    echo "[madctl] v5 解释器编译完成 → $V5"
    ;;
  gen)
    [ -z "${2:-}" ] && { echo "用法: madctl gen <spec> [out.m5]"; exit 1; }
    SRC="$2"; [ -f "$SRC" ] || SRC="$DIR/$2"
    [ -f "$SRC" ] || { echo "找不到: $2"; exit 1; }
    OUT="${3:-${SRC%.spec}.m5}"
    python3 "$GEN" "$SRC" "$OUT"
    ;;
  run)
    need_bin; [ -z "${2:-}" ] && { echo "用法: madctl run <file.m5>"; exit 1; }
    SRC="$2"; [ -f "$SRC" ] || SRC="$DIR/$2"
    [ -f "$SRC" ] || { echo "找不到: $2"; exit 1; }
    exec "$V5" "$SRC"
    ;;
  do)
    need_bin; [ -z "${2:-}" ] && { echo "用法: madctl do <spec>"; exit 1; }
    SRC="$2"; [ -f "$SRC" ] || SRC="$DIR/$2"
    [ -f "$SRC" ] || { echo "找不到: $2"; exit 1; }
    OUT="${SRC%.spec}.m5"
    echo "=== [1/3] 生成 $OUT ==="
    python3 "$GEN" "$SRC" "$OUT" || exit 1
    echo "=== [2/3] 文件内容 ==="
    cat "$OUT"
    echo "=== [3/3] 运行 ==="
    "$V5" "$OUT" < /dev/null
    ;;
  map) need_bin; exec "$V5" --map ;;
  kw)  need_bin; exec "$V5" --keywords ;;
  info)
    echo "== MADLANG v5 工具链 =="
    echo "目录:      $DIR"
    [ -x "$V5" ] && echo "解释器:    ✓ ($(stat -c%s "$V5" 2>/dev/null) bytes)" || echo "解释器:    ✗ 未编译"
    [ -f "$GEN" ] && echo "生成器:    ✓ mad5gen.py" || echo "生成器:    ✗"
    [ -f "$DIR/madlangv5.cpp" ] && echo "源码:      ✓ madlangv5.cpp ($(wc -l < "$DIR/madlangv5.cpp") 行)" || echo "源码:      ✗"
    echo "spec 文件: $(ls "$DIR"/*.spec 2>/dev/null | xargs -n1 basename 2>/dev/null | tr '\n' ' ')"
    echo "m5 文件:   $(ls "$DIR"/*.m5 2>/dev/null | xargs -n1 basename 2>/dev/null | tr '\n' ' ')"
    ;;
  *)
    echo ""
    echo "  MADLANG v5 工具链"
    echo "  ─────────────────────────────────"
    echo "  madctl compile            编译 v5 解释器"
    echo "  madctl gen <spec> [out]   从 spec 生成 .m5"
    echo "  madctl run <file.m5>      运行 .m5"
    echo "  madctl do <spec>          一键：生成→显示→运行"
    echo "  madctl map                查看 10 模式 op 表（300 条）"
    echo "  madctl kw                 查看混淆关键字"
    echo "  madctl info               状态一览"
    echo ""
    ;;
esac

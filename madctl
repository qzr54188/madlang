#!/bin/bash
set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
MADLANG="$DIR/madlang"
MADLANGC="$DIR/madlangc"
need_bin() { [ -x "$MADLANG" ] || { echo "先跑: madctl compile" >&2; exit 1; }; }
need_c()   { [ -x "$MADLANGC" ] || { echo "先跑: madctl ccompile" >&2; exit 1; }; }
case "${1:-help}" in
  compile)
    g++ -std=c++11 -O2 -pthread -o "$MADLANG" "$DIR/madlang.cpp"
    echo "[madctl] 解释器编译完成 → $MADLANG"
    ;;
  ccompile)
    g++ -std=c++11 -O2 -o "$MADLANGC" "$DIR/madlangc.cpp"
    echo "[madctl] 编译器编译完成 → $MADLANGC"
    ;;
  web)
    PORT="${2:-8765}"
    exec python3 "$DIR/madweb.py" "$PORT"
    ;;
  run)
    need_bin; [ -z "${2:-}" ] && { echo "用法: madctl run <file.mgl>"; exit 1; }
    cd "$DIR"; exec "$MADLANG" "$2"
    ;;
  cc)
    need_c; [ -z "${2:-}" ] && { echo "用法: madctl cc <file.mgl>"; exit 1; }
    SRC="$2"; [ -f "$SRC" ] || SRC="$DIR/$2"
    [ -f "$SRC" ] || { echo "找不到: $2"; exit 1; }
    OUT="${SRC%.mgl}"
    echo "[madctl] cc: $SRC → $OUT"
    "$MADLANGC" "$SRC" "$OUT.cpp" || exit 1
    g++ -std=c++11 -O2 -o "$OUT" "$OUT.cpp" || exit 1
    echo "[madctl] 完成: $OUT ($(stat -c%s "$OUT" 2>/dev/null || echo ?) bytes)"
    ;;
  build)
    need_bin; [ -z "${2:-}" ] && { echo "用法: madctl build <file.mgl> [name]"; exit 1; }
    SRC="$2"; [ -f "$SRC" ] || SRC="$DIR/$2"
    [ -f "$SRC" ] || { echo "找不到: $2"; exit 1; }
    NAME="${3:-$(basename "$SRC" .mgl)}"
    OUT="$DIR/$NAME.bundle"
    {
      echo '#!/bin/bash'
      echo 'TMP="$(mktemp -d)"; trap '"'"'rm -rf "$TMP"'"'"' EXIT'
      echo 'base64 -d > "$TMP/madlang" <<_E1'
      base64 "$MADLANG"
      echo '_E1'
      echo 'chmod +x "$TMP/madlang"'
      echo 'base64 -d > "$TMP/prog.mgl" <<_E2'
      base64 "$SRC"
      echo '_E2'
      echo 'exec "$TMP/madlang" "$TMP/prog.mgl" "$@"'
    } > "$OUT"
    chmod +x "$OUT"
    echo "[madctl] 打包完成 → $OUT"
    ;;
  repl) [ -x "$DIR/madrepl" ] || { echo "先跑: madctl rcompile"; exit 1; }; cd "$DIR"; exec "$DIR/madrepl" ;;
  rcompile)
    g++ -std=c++11 -O2 -pthread -o "$DIR/madrepl" "$DIR/madrepl.cpp"
    echo "[madctl] REPL 编译完成 → $DIR/madrepl"
    ;;
  regen) need_bin; cd "$DIR"; exec "$MADLANG" --regen ;;
  info)
    echo "== MADLANG 工具链 =="
    echo "目录:      $DIR"
    [ -x "$MADLANG" ] && echo "解释器:    ✓" || echo "解释器:    ✗"
    [ -x "$MADLANGC" ] && echo "编译器:    ✓" || echo "编译器:    ✗"
    [ -f "$DIR/madweb.py" ] && echo "Web IDE:   ✓" || echo "Web IDE:   ✗"
    [ -x "$DIR/madrepl" ] && echo "REPL:      ✓" || echo "REPL:      ✗"
    [ -f "$DIR/MADLANG_DOC.md" ] && echo "文档:      ✓" || echo "文档:      ✗"
    echo "示例:      $(ls "$DIR/examples"/*.mgl 2>/dev/null | xargs -n1 basename 2>/dev/null | tr '\n' ' ')"
    echo "打包:      $(ls "$DIR"/*.bundle 2>/dev/null | xargs -n1 basename 2>/dev/null | tr '\n' ' ')"
    ;;
  *)
    echo "命令:"
    echo "  madctl compile        编译解释器 madlang"
    echo "  madctl ccompile       编译编译器 madlangc"
    echo "  madctl web [port]     启动 Web Studio (默认 8765)"
    echo "  madctl run <f.mgl>    解释运行"
    echo "  madctl cc <f.mgl>     编译成原生二进制"
    echo "  madctl build <f.mgl>  打包成 .bundle"
    echo "  madctl regen          重建文档和示例"
    echo "  madctl info           状态一览"
    ;;
esac
